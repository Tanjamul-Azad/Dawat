{
  "name": "dawat-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "preview": "next start --hostname 127.0.0.1 --port 3000",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:status": "supabase status",
    "backend:types": "node scripts/generate-types.mjs",
    "backend:env": "node scripts/local-env.mjs",
    "backend:seller": "node scripts/bootstrap-local-seller.mjs",
    "backend:connect": "node scripts/connect-hosted.mjs",
    "media:cleanup": "node --env-file=.env.local scripts/cleanup-media.mjs",
    "test:foundation": "vitest run src/server/foundation.integration.test.ts",
    "test:local": "node scripts/verify-local.mjs",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "qa:build": "node scripts/local-qa.mjs build",
    "qa:preview": "node scripts/local-qa.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup:create": "node scripts/recovery/backup.mjs",
    "recovery:start": "node scripts/recovery/start-drill.mjs",
    "recovery:restore": "node scripts/recovery/restore-drill.mjs",
    "recovery:build": "node scripts/recovery/app.mjs build",
    "recovery:app": "node scripts/recovery/app.mjs start",
    "recovery:verify": "node scripts/recovery/app.mjs verify",
    "release:migrate": "node scripts/release/apply-hosted-migrations.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "motion": "14.6.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "pg": "8.16.3",
    "prettier": "^3.6.2",
    "supabase": "^2.121.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
