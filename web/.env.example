# Default: real backend. Missing configuration fails closed, without sample customers.
NEXT_PUBLIC_APP_MODE=backend
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Copy the Publishable key from `npm run backend:status` after starting Supabase.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AUTH_EMAIL_ENABLED=true
# On hosted Supabase, keep false until custom SMTP and OTP templates are qualified.
# Development-only legacy sandbox: NEXT_PUBLIC_APP_MODE=demo (ignored by production builds).
# Ordinary auth/management/guest queries never use a service-role bypass.
# Personal link recovery: independent 32-byte base64 AES keys, server-only.
# Retain old entries when changing GUEST_LINK_KEY_ID; back up the ring securely.
GUEST_LINK_KEY_ID=v1
GUEST_LINK_KEYS={"v1":"REPLACE_WITH_BASE64_32_RANDOM_BYTES"}
# Server-only Storage processor. Ordinary account/guest queries still use user sessions + RLS.
# Add privately from the intended Supabase project's secret/service-role key. Never NEXT_PUBLIC.
SUPABASE_MEDIA_SECRET_KEY=
